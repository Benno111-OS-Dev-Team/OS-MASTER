#!/bin/sh

set -eu

target_root="${1:-}"

if [ -z "${target_root}" ] || [ ! -d "${target_root}" ] || [ ! -r /root/os-master-x11-common.sh ]; then
  exit 0
fi

. /root/os-master-x11-common.sh

os_master_log "Attempting target-system X11 installation into ${target_root}"

if os_master_install_x11 "${target_root}"; then
  os_master_seed_desktop_login "${target_root}"
  os_master_seed_firstboot_setup "${target_root}"
  os_master_add_video_users "${target_root}"
  os_master_mark_x11_installed "${target_root}/var/db/os-master/x11-installed"
  os_master_log "Target-system X11 installation complete"
else
  os_master_seed_installed_x11_retry "${target_root}"
  os_master_seed_firstboot_setup "${target_root}"
  os_master_log "Target-system X11 installation failed; leaving installed system in text mode"
fi

exit 0
