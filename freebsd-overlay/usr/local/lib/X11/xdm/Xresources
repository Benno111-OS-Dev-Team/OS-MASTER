xlogin*greeting: Welcome to OS-MASTER
xlogin*namePrompt: User
xlogin*passwdPrompt: Password
xlogin*login.translations: #override\\n\
  Ctrl<Key>R: abort-display()\\n\
  <Key>F1: set-session-argument()finish-field()\\n\
  Ctrl<Key>H: delete-previous-character()\\n\
  <Key>BackSpace: delete-previous-character()\\n
xlogin*borderWidth: 0
xlogin*frameWidth: 0
xlogin*innerFramesWidth: 0
xlogin*failTimeout: 10
xlogin*useShape: false
xlogin*allowRootLogin: true
xlogin*face: DejaVu Sans-18
xlogin*greetFace: DejaVu Sans:bold:pixelsize=28
xlogin*promptFace: DejaVu Sans:bold:pixelsize=16
xlogin*failFace: DejaVu Sans:bold:pixelsize=16
xlogin*foreground: #f8fafc
xlogin*background: #0a0f19
xlogin*greetColor: #f8fafc
xlogin*promptColor: #cbd5e1
xlogin*failColor: #f97316
xlogin*hiColor: #111827
xlogin*shdColor: #111827
xlogin*fail: Login failed
