#!/bin/sh

# PROVIDE: os_master_x11_firstboot
# REQUIRE: NETWORKING LOGIN
# KEYWORD: nojail

. /etc/rc.subr

name="os_master_x11_firstboot"
rcvar="${name}_enable"
start_cmd="${name}_start"

: ${os_master_x11_firstboot_enable:="YES"}

os_master_x11_firstboot_start() {
  marker="/var/db/os-master/x11-installed"
  helper="/usr/local/libexec/os-master-x11-common.sh"

  if [ -f "${marker}" ]; then
    return 0
  fi
  if [ ! -r "${helper}" ]; then
    return 0
  fi

  . "${helper}"

  if os_master_x11_is_installed ""; then
    os_master_seed_desktop_login /
    os_master_add_video_users /
    os_master_mark_x11_installed "${marker}"
    os_master_log "First-boot X11 retry skipped because X11 is already installed"
    return 0
  fi

  os_master_log "Attempting first-boot X11 installation on installed system"

  if os_master_install_x11 ""; then
    os_master_seed_desktop_login /
    os_master_add_video_users /
    os_master_mark_x11_installed "${marker}"
    os_master_log "First-boot X11 installation complete"
  else
    os_master_log "First-boot X11 installation failed; will retry next boot"
  fi
}

load_rc_config "${name}"
run_rc_command "$1"
