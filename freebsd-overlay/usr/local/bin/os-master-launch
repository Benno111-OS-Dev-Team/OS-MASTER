#!/bin/sh

set -eu

app_id="${1:-}"

show_settings_fallback() {
  exec xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#111827" -fg "#e5e7eb" -bc -title "Settings" -e sh -lc 'printf "OS-MASTER desktop settings live in:\n  ~/.config/tint2/tint2rc\n  ~/.config/pcmanfm/default/desktop-items-0.conf\n  ~/.Xresources\n\nPress Enter to close."; read _'
}

case "${app_id}" in
  install)
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -geometry 132x38 -bg "#0f172a" -fg "#e5e7eb" -bc -title "OS-MASTER Installer" -e sh -lc 'clear; /usr/local/bin/os-master-install; status=$?; printf "\nInstaller exited with status %s.\n" "$status"; printf "Press Enter to close this window."; read _; exit "$status"'
    ;;
  live-shell)
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#111827" -fg "#e5e7eb" -bc -title "Live Shell"
    ;;
  terminal)
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#111827" -fg "#e5e7eb" -bc -title "Terminal"
    ;;
  files)
    exec pcmanfm "${HOME}"
    ;;
  notes)
    mkdir -p "${HOME}/Documents"
    touch "${HOME}/Documents/Notes.txt"
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#111827" -fg "#e5e7eb" -bc -title "Notes" -e sh -lc "exec ee \"${HOME}/Documents/Notes.txt\""
    ;;
  web)
    if command -v firefox >/dev/null 2>&1; then
      exec firefox
    fi
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#111827" -fg "#e5e7eb" -bc -title "Web" -e sh -lc 'printf "Install firefox to enable the original web shortcut.\n\n"; printf "Suggested command:\n  sudo pkg install firefox\n\n"; printf "Press Enter to close."; read _'
    ;;
  settings)
    if command -v pcmanfm >/dev/null 2>&1; then
      exec sh -lc 'pcmanfm --desktop-pref >/tmp/os-master-desktop-pref.log 2>&1 || pcmanfm --preferences >/tmp/os-master-pcmanfm-pref.log 2>&1 || exec /usr/local/bin/os-master-launch settings-fallback'
    fi
    show_settings_fallback
    ;;
  settings-fallback)
    show_settings_fallback
    ;;
  help)
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#111827" -fg "#e5e7eb" -bc -title "Help" -e sh -lc 'printf "Launch the desktop with:\n  startx\n\nAfter install, sign in as root once to complete hostname, network, and user setup.\n\nPress Enter to close."; read _'
    ;;
  installer-help)
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -geometry 108x28 -bg "#111827" -fg "#e5e7eb" -bc -title "Installer Help" -e sh -lc 'printf "OS-MASTER Graphical Installer\n============================\n\n1. Choose Install OS-MASTER to launch the trimmed install flow.\n2. Partition disks, select distributions, and set the root password.\n3. Hostname, network, and user creation move to the first boot desktop assistant.\n4. On the installed system, sign in as root once to finish setup.\n\nPress Enter to close."; read _'
    ;;
  reboot)
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -geometry 80x12 -bg "#111827" -fg "#e5e7eb" -bc -title "Reboot" -e sh -lc 'printf "Rebooting the live installer...\n"; sleep 1; exec /sbin/shutdown -r now'
    ;;
  *)
    exec xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#111827" -fg "#e5e7eb" -bc -title "Launcher" -e sh -lc "printf 'Unknown launcher: %s\n' '${app_id}'; printf 'Press Enter to close.'; read _"
    ;;
esac
