#!/bin/sh

set -eu

show_xmessage_menu() {
  while :; do
    xmessage \
      -center \
      -default "Install OS-MASTER" \
      -buttons "Install OS-MASTER:10,Live Shell:20,Browse Files:30,Help:40,Reboot:50,Close:0" \
      -title "OS-MASTER Installer" \
      "Welcome to the OS-MASTER graphical installer.\n\nChoose Install OS-MASTER to launch bsdinstall in a graphical terminal.\nThe installed system will seed the OS-MASTER desktop and X11 session."

    case $? in
      10) /usr/local/bin/os-master-launch install >/tmp/os-master-install.log 2>&1 & ;;
      20) /usr/local/bin/os-master-launch live-shell >/tmp/os-master-live-shell.log 2>&1 & ;;
      30) /usr/local/bin/os-master-launch files >/tmp/os-master-files.log 2>&1 & ;;
      40) /usr/local/bin/os-master-launch installer-help >/tmp/os-master-installer-help.log 2>&1 & ;;
      50) exec /usr/local/bin/os-master-launch reboot ;;
      *) break ;;
    esac
  done
}

if command -v xmessage >/dev/null 2>&1; then
  show_xmessage_menu
else
  exec /usr/local/bin/os-master-launch install
fi
