#!/bin/sh

set -eu

SESSION_BIN="/usr/local/bin/os-master-session"
BOOTSPLASH_HELPER="/usr/local/share/os-master-desktop/session/bootsplash-common.sh"

if [ -r "${BOOTSPLASH_HELPER}" ]; then
  . "${BOOTSPLASH_HELPER}"
  os_master_bootsplash_start desktop
fi

if [ ! -x "${SESSION_BIN}" ]; then
  exec /usr/local/bin/openbox-session
fi

if command -v dbus-launch >/dev/null 2>&1; then
  exec dbus-launch --exit-with-session "${SESSION_BIN}"
fi

exec "${SESSION_BIN}"
