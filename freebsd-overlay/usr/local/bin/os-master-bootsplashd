#!/bin/sh

set -eu

mode="${1:-installer}"
runtime_dir="${2:-/tmp/os-master-bootsplash-${mode}}"
frame_root="/usr/local/share/os-master-desktop/bootsplash/${mode}"
current_frame="${runtime_dir}/current.png"
progress_file="${runtime_dir}/progress"
complete_file="${runtime_dir}/complete"
pid_file="${runtime_dir}/pid"

if [ ! -d "${frame_root}" ] || ! command -v feh >/dev/null 2>&1; then
  exit 0
fi

mkdir -p "${runtime_dir}"

frame_count="$(find "${frame_root}" -maxdepth 1 -name 'frame-*.png' | wc -l | awk '{print $1}')"
if [ "${frame_count}" -lt 1 ]; then
  exit 0
fi

copy_frame() {
  frame_index="$1"
  source_frame="${frame_root}/frame-${frame_index}.png"

  if [ -f "${source_frame}" ]; then
    cp "${source_frame}" "${current_frame}"
  fi
}

cleanup() {
  if [ -n "${viewer_pid:-}" ]; then
    kill "${viewer_pid}" >/dev/null 2>&1 || true
    wait "${viewer_pid}" 2>/dev/null || true
  fi
  rm -f "${current_frame}"
  rm -f "${pid_file}"
}

trap cleanup EXIT INT TERM

copy_frame "00"
feh --fullscreen --auto-zoom --hide-pointer --reload 0.1 "${current_frame}" >/tmp/os-master-bootsplash.log 2>&1 &
viewer_pid="$!"

last_frame="-1"
last_complete_state="0"

while kill -0 "${viewer_pid}" >/dev/null 2>&1; do
  progress_value="0"
  if [ -f "${progress_file}" ]; then
    progress_value="$(tr -cd '0-9' < "${progress_file}")"
  fi
  if [ -z "${progress_value}" ]; then
    progress_value="0"
  fi
  if [ "${progress_value}" -gt 100 ]; then
    progress_value="100"
  fi

  frame_index="$(awk -v progress="${progress_value}" -v count="${frame_count}" 'BEGIN {
    if (count < 2) {
      print "00"
      exit
    }
    index = int((progress * (count - 1) + 99) / 100)
    if (index < 0) {
      index = 0
    }
    if (index > count - 1) {
      index = count - 1
    }
    printf("%02d", index)
  }')"

  if [ "${frame_index}" != "${last_frame}" ]; then
    copy_frame "${frame_index}"
    last_frame="${frame_index}"
  fi

  if [ -f "${complete_file}" ]; then
    if [ "${last_complete_state}" = "0" ]; then
      copy_frame "$(printf "%02d" "$((frame_count - 1))")"
      last_complete_state="1"
      sleep 0.6
    fi
    break
  fi

  sleep 0.1
done
