#!/bin/sh

set -eu

step() {
  printf "\n[%s/%s] %s\n" "$1" "$2" "$3"
}

run_target() {
  step "$1" "$2" "$3"
  /usr/sbin/bsdinstall "$4"
}

printf "\nOS-MASTER Installer\n"
printf   "===================\n\n"
printf "This flow installs the base system now and defers account and network setup\n"
printf "to the first boot desktop assistant.\n"
printf "\n"
printf "You will still set the root password during installation.\n"

run_target 1 8 "Select keyboard layout" keymap
run_target 2 8 "Partition disks" partedit
run_target 3 8 "Mount selected partitions" mount
run_target 4 8 "Choose and fetch distribution sets" distfetch
run_target 5 8 "Verify distribution checksums" checksum
run_target 6 8 "Extract distribution sets" distextract
run_target 7 8 "Install boot loader" bootconfig
run_target 8 8 "Set the root password" rootpass

printf "\nFinalizing installer configuration...\n"
/usr/sbin/bsdinstall entropy
/usr/sbin/bsdinstall config

printf "\nInstallation complete.\n"
printf "On first boot, sign in as root and the OS-MASTER first-boot assistant will\n"
printf "help you configure hostname, network, and your first user account.\n"
