#!/bin/sh

set -eu

MARKER="/var/db/os-master/firstboot-setup-complete"

if [ -f "${MARKER}" ]; then
  exit 0
fi

mkdir -p "$(dirname "${MARKER}")"

show_menu() {
  while :; do
    if command -v xmessage >/dev/null 2>&1; then
      xmessage \
        -center \
        -default "Open Setup" \
        -buttons "Open Setup:10,Open Root Shell:20,Mark Complete:30,Later:0" \
        -title "OS-MASTER First Boot Setup" \
        "Complete OS-MASTER setup after install.\n\nUse Open Setup to launch bsdconfig for hostname, network, and user creation.\nWhen you are finished, choose Mark Complete."
      selection=$?
    else
      selection=10
    fi

    case "${selection}" in
      10)
        xterm -fa "DejaVu Sans Mono" -fs 11 -geometry 132x38 -bg "#0f172a" -fg "#e5e7eb" -bc -title "OS-MASTER First Boot Setup" -e sh -lc 'clear; printf "\nOS-MASTER First Boot Setup\n"; printf "==========================\n\n"; printf "Complete these items before marking setup complete:\n"; printf "  1. Set the hostname\n"; printf "  2. Configure network interfaces\n"; printf "  3. Add your first user account\n\n"; printf "Recommended bsdconfig sections:\n"; printf "  Hostname, Networking, and User Management\n\n"; exec bsdconfig' &
        wait $!
        ;;
      20)
        xterm -fa "DejaVu Sans Mono" -fs 11 -bg "#111827" -fg "#e5e7eb" -bc -title "Root Shell" &
        wait $!
        ;;
      30)
        : > "${MARKER}"
        if command -v xmessage >/dev/null 2>&1; then
          xmessage -center -buttons "OK:0" -title "OS-MASTER First Boot Setup" "First boot setup marked complete."
        fi
        return 0
        ;;
      *)
        return 0
        ;;
    esac
  done
}

show_menu
